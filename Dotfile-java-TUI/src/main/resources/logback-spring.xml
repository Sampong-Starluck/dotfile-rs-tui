<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>debug.log</file>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30}:%line - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.github.sampongstarluck.dotfile" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="FILE"/>
  </root>
</configuration>
